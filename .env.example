# Telegram Bot Configuration
# Copy this file to .env and fill in the actual values
# Do NOT commit .env to version control

# Bot token obtained from @BotFather on Telegram
BOT_TOKEN=

# Telegram API ID obtained from my.telegram.org
API_ID=

# Telegram API hash obtained from my.telegram.org
API_HASH=

# Telegram user ID authorized to interact with the bot.
# This bot is for single-user use only — it will not start without this value.
# Get your user ID from @userinfobot on Telegram.
AUTHORIZED_USER_ID=

# Language Model Configuration (OpenAI-compatible endpoint)

# Base URL of an OpenAI-compatible API server, e.g. https://api.openai.com/v1
# or http://localhost:11434/v1 for a local Ollama server.
LLM_BASE_URL=

# API key for the language service (sent as Bearer token). May be empty for
# local servers that do not require authentication.
LLM_API_KEY=

# Model name passed to the chat-completions endpoint. The model must support
# tool calling; vision additionally requires a multimodal model.
LLM_MODEL=

# Application Behavior (all optional, defaults shown)

# Per-request timeout in seconds for the language service. Local models with
# tool calling often need well over a minute; raise this if you see
# "language service unreachable" errors while the server is still working.
LLM_TIMEOUT_SECONDS=300

# Send current-turn images to a vision-capable model (true/false).
# Historical images are always replaced by an [image] placeholder.
VISION_ENABLED=false

# Idle window in seconds used to collect media-group (album) fragments
# before the group is normalized into one message.
MEDIA_GROUP_TIMEOUT_SECONDS=1.5

# Maximum size in bytes of a text attachment (.txt/.md/.csv) that will be
# downloaded and shown to the assistant; larger files are only described.
MAX_FILE_SIZE_BYTES=1048576

# Number of most recent conversation messages included in each model request.
MAX_HISTORY_MESSAGES=30

# Default page size for account-capability tools (list_chats, etc.).
TOOL_DEFAULT_LIMIT=10

# Maximum number of model/tool iterations allowed within a single agent turn.
AGENT_MAX_ITERATIONS=8

# File name (without .session suffix) of the stored user-account session,
# created interactively on first run and reused for unattended restarts.
SESSION_NAME=telegramlm_owner

# Console log level for application internals: DEBUG, INFO, WARNING or ERROR.
# DEBUG adds per-iteration reasoning traces (model responses, tool calls and
# results) under the telegramlm.* namespace; third-party libraries stay capped
# at INFO so request headers, tokens and raw protocol data never reach the log.
LOG_LEVEL=INFO
